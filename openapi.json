{
  "openapi": "3.0.3",
  "info": {
    "title": "Plant Loft Tools",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://YOUR_PROJECT_REF.supabase.co/functions/v1/plant-loft"
    }
  ],
  "components": {
    "securitySchemes": {
      "PlantLoftKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-plant-loft-key"
      }
    }
  },
  "security": [
    {
      "PlantLoftKey": []
    }
  ],
  "paths": {
    "/find_products": {
      "post": {
        "operationId": "find_products",
        "summary": "Search a compact catalogue page with exact budget/name/kind filters and care notes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "session_id": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 100,
                        "description": "Stable synthetic session ID; reuse throughout this conversation. Demo only, not verified channel identity."
                      },
                      "query": {
                        "type": "string",
                        "description": "Product name substring; omit to browse."
                      },
                      "product_kind": {
                        "type": "string",
                        "enum": [
                          "plant",
                          "pot"
                        ]
                      },
                      "budget_kobo": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "limit": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5,
                        "default": 3
                      },
                      "offset": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000,
                        "default": 0
                      },
                      "size": {
                        "type": "string",
                        "description": "Exact catalogue size; use Medium for compatible pots."
                      },
                      "placement": {
                        "type": "string",
                        "enum": [
                          "INDOOR",
                          "SHELTERED_OUTDOOR",
                          "EXPOSED_OUTDOOR"
                        ]
                      }
                    },
                    "required": [
                      "session_id"
                    ]
                  }
                },
                "required": [
                  "payload"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool result"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation or business-rule failure"
          },
          "503": {
            "description": "Configuration or service unavailable"
          }
        },
        "description": "Always filter product_kind=plant and budget_kobo for a budget request (NGN 5000 = 500000 kobo). Use limit 3; results include total_matches, has_more and next_offset. Zero total_matches is conclusive for that filter. Never browse the full catalogue. query is a name substring; size can filter pots to Medium."
      }
    },
    "/prepare_quote": {
      "post": {
        "operationId": "prepare_quote",
        "summary": "Calculate and persist the selected basket quote; return authoritative totals and identifiers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "session_id": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 100,
                        "description": "Stable synthetic session ID; reuse throughout this conversation. Demo only, not verified channel identity."
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "SALE",
                          "RENTAL"
                        ]
                      },
                      "transport": {
                        "type": "string",
                        "enum": [
                          "SELF_PICKUP",
                          "BUSINESS_DELIVERY"
                        ]
                      },
                      "start_at": {
                        "type": "string",
                        "description": "Rental only: ISO timestamp with UTC offset."
                      },
                      "end_at": {
                        "type": "string",
                        "description": "Actual requested collection/return time, with timezone. Do not extend to fill billing days; backend bills each started 24-hour period."
                      },
                      "setup": {
                        "type": "boolean"
                      },
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 20,
                        "items": {
                          "type": "object",
                          "properties": {
                            "product_id": {
                              "type": "string",
                              "description": "Sales: ID returned by find_products."
                            },
                            "pot_id": {
                              "type": "string",
                              "description": "Sales: compatible medium pot ID."
                            },
                            "category": {
                              "type": "string",
                              "enum": [
                                "GOLDEN_PALM",
                                "LADY_PALM",
                                "SMALL_PLANT"
                              ],
                              "description": "Rentals only."
                            },
                            "quantity": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 40
                            }
                          },
                          "required": [
                            "quantity"
                          ]
                        }
                      },
                      "delivery_details": {
                        "type": "object",
                        "description": "Test delivery details only for this assessment. Never use real personal contact details.",
                        "properties": {
                          "area": {
                            "type": "string",
                            "maxLength": 250
                          },
                          "address": {
                            "type": "string",
                            "maxLength": 250
                          },
                          "landmark": {
                            "type": "string",
                            "maxLength": 250
                          },
                          "phone": {
                            "type": "string",
                            "maxLength": 250
                          }
                        },
                        "additionalProperties": false
                      },
                      "new_order": {
                        "type": "boolean",
                        "default": false,
                        "description": "True only if the customer explicitly requests a separate additional order. Never set true for a retry or repeated yes. Same-session unchanged selections otherwise reuse a recent draft/request."
                      },
                      "transport_confirmed": {
                        "type": "boolean",
                        "description": "True only after explicit customer pickup/delivery choice."
                      },
                      "event_logistics": {
                        "type": "object",
                        "properties": {
                          "venue_access_at": {
                            "type": "string"
                          },
                          "setup_ready_at": {
                            "type": "string"
                          },
                          "onsite_contact": {
                            "type": "string"
                          }
                        },
                        "description": "Required for setup: confirmed venue access, setup completion and onsite contact."
                      }
                    },
                    "required": [
                      "session_id",
                      "kind",
                      "transport",
                      "items",
                      "transport_confirmed"
                    ]
                  }
                },
                "required": [
                  "payload"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool result"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation or business-rule failure"
          },
          "503": {
            "description": "Configuration or service unavailable"
          }
        },
        "description": "Create a stored draft before showing a total. Keep draft references internal. If the customer already confirmed unchanged commercial terms but draft tool context was lost, recover the exact basket, verify the returned total is unchanged and call confirm_request in the SAME TURN. Never ask consent again for this internal recovery. Never renew an already saved request. The server reuses the same selection within 30 minutes in this session, including a saved request. Only set new_order:true when the customer explicitly wants a separate additional order."
      }
    },
    "/confirm_request": {
      "post": {
        "operationId": "confirm_request",
        "summary": "Persist a customer-confirmed quote once. Reuse quote ID on retries. Rental requests await owner review.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "session_id": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 100,
                        "description": "Stable synthetic session ID; reuse throughout this conversation. Demo only, not verified channel identity."
                      },
                      "quote_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "confirmed": {
                        "type": "boolean",
                        "description": "True only after customer explicitly confirms the displayed quote."
                      },
                      "quote_code": {
                        "type": "string",
                        "description": "Private PL- tracking code returned by prepare_quote and displayed in the chat. Reuse it across turns. Never reveal to other customers."
                      },
                      "transport_version": {
                        "type": "integer",
                        "description": "Only when customer explicitly accepts a revised transport total; use latest returned version."
                      },
                      "confirmed_total_kobo": {
                        "type": "integer",
                        "description": "Exact revised total explicitly confirmed by customer, in kobo."
                      }
                    },
                    "required": [
                      "quote_code",
                      "confirmed"
                    ]
                  }
                },
                "required": [
                  "payload"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool result"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation or business-rule failure"
          },
          "503": {
            "description": "Configuration or service unavailable"
          }
        },
        "description": "On explicit yes to the existing summary, call immediately with the exact returned quote_code. No re-quote or second confirmation. Revised delivery acceptance includes current transport_version and confirmed_total_kobo. On timeout retrieve the same request before retry. customer_reference is a short display reference only, never an access credential."
      }
    },
    "/get_request": {
      "post": {
        "operationId": "get_request",
        "summary": "Recover an existing request using the original quote ID and synthetic session ID.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "session_id": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 100,
                        "description": "Stable synthetic session ID; reuse throughout this conversation. Demo only, not verified channel identity."
                      },
                      "quote_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "quote_code": {
                        "type": "string",
                        "description": "Private PL- tracking code returned by prepare_quote and displayed in the chat. Reuse it across turns. Never reveal to other customers."
                      },
                      "check_payment": {
                        "type": "boolean",
                        "description": "Set true only when checking claimed test payment; the server verifies the exact reference, test domain, currency and amount with Paystack."
                      },
                      "customer_action": {
                        "type": "string",
                        "enum": [
                          "received",
                          "review",
                          "report_return",
                          "report_issue"
                        ],
                        "description": "received only after customer explicitly confirms actual receipt; review only for actual supplied feedback after fulfilment."
                      },
                      "confirmed": {
                        "type": "boolean"
                      },
                      "product_rating": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "service_rating": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "product_feedback": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "service_feedback": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "overall_feedback": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "replace_review": {
                        "type": "boolean",
                        "description": "Only after explicit consent to replace existing feedback."
                      },
                      "issue_details": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "handover_description": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "received_by": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "reported_handover_at": {
                        "type": "string",
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "quote_code"
                    ]
                  }
                },
                "required": [
                  "payload"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool result"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation or business-rule failure"
          },
          "503": {
            "description": "Configuration or service unavailable"
          }
        },
        "description": "Recover with exact private quote_code. A valid draft returns found:true, quote_persisted:true, request_saved:false and save_payload. If the customer already confirmed, call confirm_request with that payload now; do not ask again. A saved request returns request_saved:true. Do not treat an unsaved draft as an invented code. After approved-total acceptance, return backend payment_options immediately. On customer paid claim or payment status check set check_payment:true; never treat a screenshot or claim as verified payment. Supports customer_action received with confirmed:true and review with explicitly supplied product/service rating or feedback. Never assume payment, ratings or delivery. Owner bank confirmation is read from the saved request, never written by this tool."
      }
    }
  }
}
